# CIXIO.COM Environment Configuration - STAGE SERVER
# Copy this file to .env and update values

# ============================================
# Deployment Configuration
# ============================================
DEPLOY_TARGET=stage

# ============================================
# Stage Server Configuration
# ============================================
# Uses SSH config host alias (see ~/.ssh/config)
STAGE_SERVER_SSH_HOST=cixio-stage-server
STAGE_SERVER_BASE_DIR=/home/ec2-user/cixio.com/landing1

# MongoDB Server SSH (for auto-fetching DB password during deploy)
MONGO_SERVER_SSH_HOST=cixio-mongodb-server
MONGO_SERVER_ENV_PATH=/home/ec2-user/cixio-database/mvp_10_cixio-database/.env

# Ensure your ~/.ssh/config has:
# Host cixio-stage-server
#     HostName 172.31.45.88
#     User ec2-user
#     IdentityFile ~/.ssh/id_ed25519_stage
#     StrictHostKeyChecking no
#     UserKnownHostsFile=/dev/null
#
# Host cixio-mongodb-server
#     HostName 172.31.33.96
#     User ec2-user
#     IdentityFile ~/.ssh/id_ed25519_stage
#     StrictHostKeyChecking no
#     UserKnownHostsFile=/dev/null

# ============================================
# Application Configuration
# ============================================
NODE_ENV=staging
PORT=80
APP_NAME=cixio-com-app

# ============================================
# MongoDB Configuration - Production Server (Remote)
# ============================================
# Stage connects to Production MongoDB via VPC private IP
# Authentication is REQUIRED - MongoDB has authorization enabled
MONGODB_HOST=172.31.33.96
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_DATABASE=cixio

# Database credentials (MUST match those created by mongo-init in cixio-database)
CIXIO_COM_DB_USER=cixio_com_user
CIXIO_COM_DB_PASSWORD=CHANGE_THIS_MATCH_CENTRAL_DB_ENV

# Full connection string (with auth + correct database name + authSource)
MONGODB_URI=mongodb://cixio_com_user:CHANGE_THIS_MATCH_CENTRAL_DB_ENV@172.31.33.96:27017,172.31.33.96:27018,172.31.33.96:27019/cixio?replicaSet=rs0&authSource=cixio&directConnection=false

# ============================================
# Frontend & API URLs
# ============================================
FRONTEND_URL=https://www.cixio.com
API_URL=https://www.cixio.com/api

# ============================================
# JWT Configuration
# ============================================
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRE=7d

# ============================================
# Email Configuration (AWS SES SMTP)
# ============================================
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=CIXIO <noreply@cixio.com>
EMAIL_FROM_NAME=CIXIO
EMAIL_FROM_ADDRESS=noreply@cixio.com
SUPPORT_EMAIL=support@cixio.com
INFO_EMAIL=info@cixio.com
ADMIN_EMAIL=admin@cixio.com

# ============================================
# CORS Configuration
# ============================================
ALLOWED_ORIGINS=https://www.cixio.com,https://cixio.com,http://localhost:3000

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ============================================
# Account Security
# ============================================
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000
PASSWORD_RESET_EXPIRE=3600000
EMAIL_VERIFICATION_EXPIRE=86400000

# ============================================
# Subscription Configuration
# ============================================
TRIAL_PERIOD_DAYS=14
DEFAULT_CURRENCY=USD

# ============================================
# File Upload
# ============================================
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_TO_FILE=true
