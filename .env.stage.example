# CIXIO.COM Environment Configuration - STAGE SERVER
# Copy this file to .env and update values

# ============================================
# Deployment Configuration
# ============================================
DEPLOY_TARGET=stage

# ============================================
# Stage Server Configuration
# ============================================
# Uses SSH config host alias (see ~/.ssh/config)
STAGE_SERVER_SSH_HOST=cixio-stage-server
STAGE_SERVER_BASE_DIR=/home/ec2-user/cixio.com/landing1

# Ensure your ~/.ssh/config has:
# Host cixio-stage-server
#     HostName 172.31.45.88
#     User ec2-user
#     IdentityFile ~/.ssh/id_ed25519_stage
#     StrictHostKeyChecking no
#     UserKnownHostsFile=/dev/null

# ============================================
# Application Configuration
# ============================================
NODE_ENV=staging
PORT=80
APP_NAME=cixio-com-app

# ============================================
# MongoDB Configuration - Production Server (Remote)
# ============================================
# Stage connects to Production MongoDB via VPC private IP
# Authentication is REQUIRED - MongoDB has authorization enabled
MONGODB_HOST=172.31.33.96
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_DATABASE=cixio

# Database credentials (MUST match those created by mongo-init in cixio-database)
CIXIO_COM_DB_USER=cixio_com_user
CIXIO_COM_DB_PASSWORD=CHANGE_THIS_MATCH_CENTRAL_DB_ENV

# Full connection string (with auth + correct database name + authSource)
MONGODB_URI=mongodb://cixio_com_user:CHANGE_THIS_MATCH_CENTRAL_DB_ENV@172.31.33.96:27017,172.31.33.96:27018,172.31.33.96:27019/cixio?replicaSet=rs0&authSource=cixio&directConnection=false

# ============================================
# Logging
# ============================================
LOG_LEVEL=debug
LOG_TO_FILE=true

# ============================================
# Additional Application Settings
# ============================================
# Add your application-specific environment variables here
