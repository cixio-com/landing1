# CIXIO.COM Environment Configuration - PRODUCTION SERVER
# Copy this file to .env and update values

# ============================================
# Deployment Configuration
# ============================================
DEPLOY_TARGET=production

# ============================================
# Production Server Configuration
# ============================================
# Uses SSH config host alias (see ~/.ssh/config)
PRODUCTION_SERVER_SSH_HOST=cixio-production-server
PRODUCTION_SERVER_BASE_DIR=/home/ec2-user/cixio.com/landing1

# Ensure your ~/.ssh/config has:
# Host cixio-production-server
#     HostName 172.31.36.168
#     User ec2-user
#     IdentityFile ~/.ssh/id_ed25519
#     StrictHostKeyChecking no
#     UserKnownHostsFile=/dev/null

# ============================================
# Application Configuration
# ============================================
NODE_ENV=production
PORT=80
APP_NAME=cixio-com-app

# ============================================
# MongoDB Configuration - Local (Docker Network)
# ============================================
# Production uses local MongoDB containers via Docker network
MONGODB_HOST=cixio-mongo1
MONGODB_PORT=27017
MONGODB_REPLICA_SET=rs0
MONGODB_DATABASE=cixio_com_production

# Database credentials (set these for production)
CIXIO_COM_DB_USER=cixio_com_user
CIXIO_COM_DB_PASSWORD=your_secure_password_here

# Full connection string (uses Docker container names)
MONGODB_URI=mongodb://${CIXIO_COM_DB_USER}:${CIXIO_COM_DB_PASSWORD}@cixio-mongo1:27017,cixio-mongo2:27017,cixio-mongo3:27017/cixio_com_production?replicaSet=rs0&authSource=cixio_com_production

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
LOG_TO_FILE=true

# ============================================
# Additional Application Settings
# ============================================
# Add your application-specific environment variables here
