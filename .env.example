# =============================================================================
# CIXIO ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# For local development:
# MONGODB_URI=mongodb://localhost:27017/cixio

# For MongoDB Atlas (recommended for production):
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cixio?retryWrites=true&w=majority

# For Docker/Docker Compose:
# MONGODB_URI=mongodb://mongo:27017/cixio

MONGODB_URI=mongodb://localhost:27017/cixio

# -----------------------------------------------------------------------------
# JWT CONFIGURATION
# -----------------------------------------------------------------------------
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random
JWT_EXPIRE=7d

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (SMTP for www.cixio.com)
# -----------------------------------------------------------------------------
# Email service provider settings

# For Gmail (Development only - not recommended for production):
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-app-specific-password

# For SendGrid:
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_USER=apikey
# EMAIL_PASS=your-sendgrid-api-key

# For AWS SES:
# EMAIL_HOST=email-smtp.us-east-1.amazonaws.com
# EMAIL_PORT=587
# EMAIL_USER=your-aws-smtp-username
# EMAIL_PASS=your-aws-smtp-password

# For Mailgun:
# EMAIL_HOST=smtp.mailgun.org
# EMAIL_PORT=587
# EMAIL_USER=postmaster@your-domain.mailgun.org
# EMAIL_PASS=your-mailgun-smtp-password

# For cPanel/Custom SMTP (Recommended for www.cixio.com):
EMAIL_HOST=mail.cixio.com
EMAIL_PORT=587
EMAIL_USER=noreply@cixio.com
EMAIL_PASS=your-email-password

# Email sender information
EMAIL_FROM=CIXIO <noreply@cixio.com>
EMAIL_FROM_NAME=CIXIO
EMAIL_FROM_ADDRESS=noreply@cixio.com

# Support email
SUPPORT_EMAIL=support@cixio.com
INFO_EMAIL=info@cixio.com

# -----------------------------------------------------------------------------
# FRONTEND URL (for email links)
# -----------------------------------------------------------------------------
# Development:
# FRONTEND_URL=http://localhost:8000

# Production:
FRONTEND_URL=https://www.cixio.com

# API URL
API_URL=https://www.cixio.com/api

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://www.cixio.com,https://cixio.com,http://localhost:8000,http://localhost:3000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# -----------------------------------------------------------------------------
# ACCOUNT SECURITY
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000
PASSWORD_RESET_EXPIRE=3600000
EMAIL_VERIFICATION_EXPIRE=86400000

# -----------------------------------------------------------------------------
# SUBSCRIPTION CONFIGURATION
# -----------------------------------------------------------------------------
TRIAL_PERIOD_DAYS=14
DEFAULT_CURRENCY=USD

# -----------------------------------------------------------------------------
# FILE UPLOAD (Optional - for future use)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Optional - for future integration)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# -----------------------------------------------------------------------------
# ADDITIONAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-s3-bucket
