# =============================================================================
# CIXIO.COM ENVIRONMENT CONFIGURATION - TEMPLATE
# =============================================================================
# This is a template file with dummy values for reference
# 
# USAGE:
#   1. Copy this file: cp .env.example .env
#   2. Fill in the real values (replace all YOUR_* placeholders)
#   3. Never commit .env files with real secrets!
#
# FOR DEPLOYMENTS:
#   - Deploy scripts will create environment-specific .env files
#   - Stage: deploy-stage.sh auto-fills MongoDB password in .env.stage
#   - Production: deploy-production.sh auto-fills MongoDB password in .env.production
# =============================================================================

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION
# -----------------------------------------------------------------------------
# Target server for deployment: 'stage' or 'production'
DEPLOY_TARGET=stage

# Stage Server Configuration (SSH via ~/.ssh/config alias)
STAGE_SERVER_SSH_HOST=cixio-stage-server
STAGE_SERVER_USER=ec2-user
STAGE_SERVER_IP=your-stage-server-ip
STAGE_SERVER_SSH_KEY=~/.ssh/your-ssh-key
STAGE_SERVER_BASE_DIR=/home/ec2-user/your-app-path

# Production Server Configuration (SSH via ~/.ssh/config alias)
PRODUCTION_SERVER_SSH_HOST=cixio-production-server
PRODUCTION_SERVER_USER=ec2-user
PRODUCTION_SERVER_IP=your-production-server-ip
PRODUCTION_SERVER_SSH_KEY=~/.ssh/your-ssh-key
PRODUCTION_SERVER_BASE_DIR=/home/ec2-user/your-app-path

# MongoDB Server SSH (for auto-fetching DB password during deploy)
MONGO_SERVER_SSH_HOST=cixio-mongodb-server
MONGO_SERVER_ENV_PATH=/home/ec2-user/cixio-database/mvp_10_cixio-database/.env

# Ensure your ~/.ssh/config has entries for:
#   - cixio-stage-server (your stage server IP)
#   - cixio-production-server (your production server IP)
#   - cixio-mongodb-server (your MongoDB server IP)

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION (Development/Build Server)
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION (Development/Build Server)
# -----------------------------------------------------------------------------
# For local development with MongoDB Compass:
MONGODB_URI=mongodb://localhost:27017/cixio_dev

# For Docker/Docker Compose (access from host machine):
# MONGODB_URI=mongodb://admin:your_password@localhost:27017/cixio_dev?authSource=admin

# -----------------------------------------------------------------------------
# JWT CONFIGURATION
# -----------------------------------------------------------------------------
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-to-128-char-hex-string-generated-with-openssl-or-crypto
JWT_EXPIRE=7d

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION (AWS SES SMTP)
# -----------------------------------------------------------------------------
# AWS SES SMTP Configuration (Get from AWS Console)
EMAIL_HOST=email-smtp.your-region.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=YOUR_AWS_SES_SMTP_USERNAME
EMAIL_PASS=YOUR_AWS_SES_SMTP_PASSWORD

# Email sender information
EMAIL_FROM=Your Company <noreply@yourdomain.com>
EMAIL_FROM_NAME=Your Company
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Support and info emails
SUPPORT_EMAIL=support@yourdomain.com
INFO_EMAIL=info@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# -----------------------------------------------------------------------------
# FRONTEND URL (for email links)
# -----------------------------------------------------------------------------
# Development:
FRONTEND_URL=http://localhost:3000

# Production (uncomment and update):
# FRONTEND_URL=https://www.yourdomain.com

# API URL
API_URL=http://localhost:3000/api

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://www.yourdomain.com,https://yourdomain.com,http://localhost:8000,http://localhost:3000

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# -----------------------------------------------------------------------------
# ACCOUNT SECURITY
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000
PASSWORD_RESET_EXPIRE=3600000
EMAIL_VERIFICATION_EXPIRE=86400000

# -----------------------------------------------------------------------------
# SUBSCRIPTION CONFIGURATION
# -----------------------------------------------------------------------------
TRIAL_PERIOD_DAYS=14
DEFAULT_CURRENCY=USD

# -----------------------------------------------------------------------------
# FILE UPLOAD (Optional - for future use)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Optional - for future integration)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# -----------------------------------------------------------------------------
# ADDITIONAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-s3-bucket

