# =============================================================================
# CIXIO ENVIRONMENT CONFIGURATION
# =============================================================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit .env file to version control
# =============================================================================

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=80  # Internal port for Docker container (externally accessible via 5001)

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# Central MongoDB Replica Set (CIXIO-DATABASE/mvp_10_cixio-database)
# Each app uses its own database (separate schema) in the shared cluster
#
# For Docker Compose (connects via cixio-shared-db network):
CIXIO_COM_DB_USER=cixio_com_user
CIXIO_COM_DB_PASSWORD=CHANGE_THIS_MATCH_CENTRAL_DB_ENV

# Connection string (auto-constructed in docker-compose.yml):
# mongodb://cixio_com_user:<password>@cixio-mongo1:27017,cixio-mongo2:27017,cixio-mongo3:27017/cixio?replicaSet=rs0&authSource=cixio

# MULTI-EC2 MODE: If MongoDB is on a separate EC2, override MONGODB_URI with the DB server's private IP:
# MONGODB_URI=mongodb://cixio_com_user:<password>@<DB_PRIVATE_IP>:27017,<DB_PRIVATE_IP>:27018,<DB_PRIVATE_IP>:27019/cixio?replicaSet=rs0&authSource=cixio&directConnection=false

# For local development (standalone):
# MONGODB_URI=mongodb://localhost:27017/cixio

MONGODB_URI=mongodb://localhost:27017/cixio

# -----------------------------------------------------------------------------
# JWT CONFIGURATION
# -----------------------------------------------------------------------------
# Generate a secure random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-make-it-very-long-and-random
JWT_EXPIRE=7d

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# AWS SES SMTP Configuration (Recommended for production)
EMAIL_HOST=email-smtp.ap-south-1.amazonaws.com
EMAIL_PORT=587
EMAIL_USER=your-aws-ses-smtp-username
EMAIL_PASS=your-aws-ses-smtp-password

# Email sender information
# Recommended format: "Friendly Name <email@domain.com>"
# Examples: "Cixio Team <noreply@cixio.com>", "Cixio Support <support@cixio.com>"
# IMPORTANT: Values with special characters like < > must be quoted
EMAIL_FROM="Cixio Team <noreply@cixio.com>"
EMAIL_FROM_NAME="Cixio Team"
EMAIL_FROM_ADDRESS=noreply@cixio.com

# Support and admin emails
SUPPORT_EMAIL=support@cixio.com
INFO_EMAIL=info@cixio.com
ADMIN_EMAIL=admin@cixio.com

# -----------------------------------------------------------------------------
# FRONTEND URL (for email links)
# -----------------------------------------------------------------------------
# Development:
# FRONTEND_URL=http://localhost:8000

# Production:
FRONTEND_URL=https://www.cixio.com

# API URL
API_URL=https://www.cixio.com/api

# -----------------------------------------------------------------------------
# CORS CONFIGURATION
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://www.cixio.com,https://cixio.com,https://www.cixio.ai,https://cixio.ai,https://www.cixio.io,https://cixio.io,https://www.cixio.in,https://cixio.in,http://localhost:8000,http://localhost:3000,http://localhost

# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# -----------------------------------------------------------------------------
# ACCOUNT SECURITY
# -----------------------------------------------------------------------------
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_TIME=7200000
PASSWORD_RESET_EXPIRE=3600000
EMAIL_VERIFICATION_EXPIRE=86400000

# -----------------------------------------------------------------------------
# SUBSCRIPTION CONFIGURATION
# -----------------------------------------------------------------------------
TRIAL_PERIOD_DAYS=14
DEFAULT_CURRENCY=USD

# -----------------------------------------------------------------------------
# FILE UPLOAD (Optional - for future use)
# -----------------------------------------------------------------------------
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# -----------------------------------------------------------------------------
# LOGGING
# -----------------------------------------------------------------------------
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# PAYMENT GATEWAY (Optional - for future integration)
# -----------------------------------------------------------------------------
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# -----------------------------------------------------------------------------
# ADDITIONAL SERVICES (Optional)
# -----------------------------------------------------------------------------
# REDIS_URL=redis://localhost:6379
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_REGION=us-east-1
# S3_BUCKET=your-s3-bucket

# -----------------------------------------------------------------------------
# DEPLOYMENT CONFIGURATION (For deployment scripts)
# -----------------------------------------------------------------------------
# IMPORTANT: These values are REQUIRED for deployment scripts to work
# No default values - you must configure these in your .env file

# Target server for deployment: 'stage' or 'production'
DEPLOY_TARGET=stage

# Stage Server Configuration (REQUIRED)
STAGE_SERVER_USER=ec2-user
STAGE_SERVER_IP=172.31.45.88
STAGE_SERVER_SSH_KEY=~/.ssh/id_ed25519
STAGE_SERVER_BASE_DIR=/home/ec2-user/cixio.com/landing1

# Production Server Configuration (REQUIRED)
PRODUCTION_SERVER_USER=ec2-user
PRODUCTION_SERVER_IP=172.31.36.168
PRODUCTION_SERVER_SSH_KEY=~/.ssh/id_ed25519
PRODUCTION_SERVER_BASE_DIR=/home/ec2-user/cixio.com/landing1

# Local Project Directory (Optional - defaults to current directory)
# LOCAL_PROJECT_DIR=/home/ec2-user/cixio.com/landing1

